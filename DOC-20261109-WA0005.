<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Kamera Zoom AI</title>
<style>
:root{--bg:#000;--fg:#fff;--pill:rgba(0,0,0,.55);--side:#2a2a2a;--on:#ffd33d;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px);color-scheme:dark}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
html,body{height:100%;margin:0;overflow:hidden;background:var(--bg);color:var(--fg);font-family:system-ui,sans-serif}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
#app{height:100%;display:flex;flex-direction:column}
#vf{position:relative;flex:1;min-height:0;overflow:hidden;touch-action:none;background:#111;border-radius:16px}
#vf video,#vf img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;transform-origin:center}
#msg,#tip{position:absolute;left:16px;right:16px;top:50%;transform:translateY(-50%);text-align:center;opacity:.8;font-size:15px}
#tip{top:auto;bottom:64px;transform:none;background:var(--pill);border-radius:10px;padding:8px}
#zl{position:absolute;top:12px;left:50%;transform:translateX(-50%);background:var(--pill);border-radius:14px;padding:4px 12px;font-size:14px}
#zp{position:absolute;bottom:12px;left:0;right:0;display:flex;justify-content:center;gap:8px}
#zp button{width:40px;height:40px;border-radius:50%;border:0;background:var(--pill);color:var(--fg);font-size:14px}
#zp button.on{color:var(--on);font-weight:700}
#bar{height:120px;display:flex;align-items:center;justify-content:space-around}
.side{width:52px;height:52px;border-radius:50%;background:var(--side);color:var(--fg);border:0;font-size:22px}
#sh{width:76px;height:76px;border-radius:50%;border:4px solid #fff;background:#fff;box-shadow:inset 0 0 0 4px #000}
#sh:active{transform:scale(.92)}
#res{position:fixed;inset:0;background:#000;display:flex;flex-direction:column;padding:env(safe-area-inset-top,0px) 12px env(safe-area-inset-bottom,0px)}
#res[hidden],[hidden]{display:none!important}
#res .out{flex:1;min-height:0;display:flex;align-items:center;justify-content:center}
#out{max-width:100%;max-height:100%;border-radius:12px}
.tabs{display:flex;gap:8px;justify-content:center;padding:12px 0}
.tabs button{border:0;border-radius:18px;padding:10px 18px;font-size:15px;background:var(--side);color:var(--fg)}
.tabs button.on{background:#fff;color:#000}
.hint{text-align:center;font-size:12px;opacity:.6;padding-bottom:6px}
</style>
</head>
<body>
<div id="app">
<div id="vf">
<video id="v" autoplay playsinline muted hidden></video>
<img id="im" hidden alt="">
<div id="msg">Membuka kamera...</div>
<div id="zl">1.0x</div>
<div id="tip" hidden></div>
<div id="zp"><button data-z="1" class="on">1x</button><button data-z="2">2x</button><button data-z="4">4x</button><button data-z="8">8x</button></div>
</div>
<div id="bar">
<button class="side" id="gal" aria-label="Galeri">🖼</button>
<button id="sh" aria-label="Jepret"></button>
<button class="side" id="flip" aria-label="Balik kamera">⟲</button>
</div>
</div>
<div id="res" hidden>
<div class="out"><img id="out" alt="Hasil"></div>
<div class="tabs"><button id="tb">Sebelum</button><button id="ta" class="on">Sesudah</button><button id="tr">Ulangi</button></div>
<div class="hint">Tekan lama gambar untuk menyimpan. Sesudah = penajaman sederhana, belum AI.</div>
</div>
<input id="fg" type="file" accept="image/*" hidden>
<input id="fc" type="file" accept="image/*" capture="environment" hidden>
<script>
const $=i=>document.getElementById(i);
const v=$('v'),im=$('im'),vf=$('vf'),msg=$('msg');
let stream,facing='environment',live=false,imgMode=false,zoom=1,urls={},tt;
function tip(t){const e=$('tip');e.textContent=t;e.hidden=false;clearTimeout(tt);tt=setTimeout(()=>e.hidden=true,3000)}
function setZoom(k){zoom=Math.max(1,Math.min(8,k));const t='scale('+zoom+')';v.style.transform=im.style.transform=t;
[...$('zp').children].forEach(b=>b.classList.toggle('on',Math.abs(b.dataset.z-zoom)<.05));$('zl').textContent=zoom.toFixed(1)+'x'}
[...$('zp').children].forEach(b=>b.onclick=()=>setZoom(+b.dataset.z));
let pd=0,pz=1;const dist=e=>Math.hypot(e.touches[0].clientX-e.touches[1].clientX,e.touches[0].clientY-e.touches[1].clientY);
vf.addEventListener('touchstart',e=>{if(e.touches.length==2){pd=dist(e);pz=zoom}},{passive:true});
vf.addEventListener('touchmove',e=>{if(e.touches.length==2&&pd)setZoom(pz*dist(e)/pd)},{passive:true});
vf.addEventListener('touchend',()=>{pd=0});
async function start(){
if(stream)stream.getTracks().forEach(t=>t.stop());
try{stream=await navigator.mediaDevices.getUserMedia({video:{facingMode:facing},audio:false});
v.srcObject=stream;await v.play().catch(()=>{});v.hidden=false;live=true;msg.hidden=true}
catch(e){live=false;v.hidden=true;msg.hidden=false;msg.textContent='Kamera langsung tidak bisa dibuka di halaman ini. Tekan tombol jepret untuk memakai kamera HP, atau buka galeri.'}}
function showImg(f){if(!f)return;im.onload=()=>{imgMode=true;im.hidden=false;v.hidden=true;msg.hidden=true;setZoom(1);$('flip').textContent='✕';tip('Foto dimuat. Atur zoom lalu tekan jepret.')};im.src=URL.createObjectURL(f)}
function closeImg(){imgMode=false;im.hidden=true;$('flip').textContent='⟲';setZoom(1);if(live)v.hidden=false;else msg.hidden=false}
$('fg').onchange=e=>{showImg(e.target.files[0]);e.target.value=''};
$('fc').onchange=e=>{showImg(e.target.files[0]);e.target.value=''};
$('gal').onclick=()=>$('fg').click();
$('flip').onclick=()=>{if(imgMode)closeImg();else{facing=facing==='environment'?'user':'environment';start()}};
// GANTI FUNGSI INI dengan model AI (ONNX Runtime Web / TensorFlow.js) nanti
function enhance(c){const x=c.getContext('2d'),w=c.width,h=c.height,d=x.getImageData(0,0,w,h),s=d.data,o=new Uint8ClampedArray(s);
for(let y=1;y<h-1;y++)for(let i=1;i<w-1;i++)for(let ch=0;ch<3;ch++){const p=(y*w+i)*4+ch;o[p]=5*s[p]-s[p-4]-s[p+4]-s[p-w*4]-s[p+w*4]}
x.putImageData(new ImageData(o,w,h),0,0)}
function snap(el,sw,sh){
const ar=vf.clientWidth/vf.clientHeight;let bw,bh;
if(sw/sh>ar){bh=sh;bw=sh*ar}else{bw=sw;bh=sw/ar}
const cw=bw/zoom,ch=bh/zoom,W=Math.min(Math.round(bw),720),H=Math.round(W/ar);
const a=document.createElement('canvas'),b=document.createElement('canvas');
for(const c of[a,b]){c.width=W;c.height=H;const g=c.getContext('2d');g.imageSmoothingQuality='low';g.drawImage(el,(sw-cw)/2,(sh-ch)/2,cw,ch,0,0,W,H)}
urls.before=a.toDataURL('image/jpeg',.92);enhance(b);urls.after=b.toDataURL('image/jpeg',.92);
show('after');$('res').hidden=false}
function show(k){$('out').src=urls[k];$('ta').classList.toggle('on',k==='after');$('tb').classList.toggle('on',k==='before')}
$('ta').onclick=()=>show('after');$('tb').onclick=()=>show('before');$('tr').onclick=()=>{$('res').hidden=true};
$('sh').onclick=()=>{
if(imgMode)snap(im,im.naturalWidth,im.naturalHeight);
else if(live&&v.videoWidth)snap(v,v.videoWidth,v.videoHeight);
else $('fc').click()};
start();
</script>
</body>
</html>
